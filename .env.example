# ==========================================================
#  TestLab — muhit sozlamalari
#
#  Nusxa oling va to'ldiring:
#      Windows:  copy .env.example .env
#      Linux:    cp .env.example .env
# ==========================================================

# ----------------------------------------------------------
#  1) BOT  (MAJBURIY)
# ----------------------------------------------------------
# Tokenni @BotFather dan oling
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Bot username (@ belgisisiz) — ulashish havolalari uchun
BOT_USERNAME=TestLabBot

# ----------------------------------------------------------
#  2) ADMINLAR  (MAJBURIY)
# ----------------------------------------------------------
# Telegram ID raqamlaringiz, vergul bilan.
# O'z ID'ingizni bilish uchun @userinfobot ga yozing.
ADMIN_IDS=123456789

# ----------------------------------------------------------
#  3) MAJBURIY OBUNA
# ----------------------------------------------------------
# Bo'sh qoldirilsa tekshiruv umuman ishlamaydi.
# Kanal qo'shsangiz darhol kuchga kiradi — kodga tegish shart emas.
#
# Format: @kanal1,@kanal2
# Yopiq kanal uchun ID ham bo'ladi: -1001234567890
# (lekin unda foydalanuvchiga havola tugmasi ko'rsatilmaydi)
#
# ⚠️ Bot har bir kanalda ADMIN bo'lishi kerak, aks holda a'zolikni
# tekshira olmaydi. Tekshirib bo'lmagan kanal O'TKAZIB YUBORILADI:
# sozlama xatosi tufayli butun bot qulflanib qolmasligi uchun.
#
# Adminlar hech qachon tekshirilmaydi.
REQUIRED_CHANNELS=

# ----------------------------------------------------------
#  4) MA'LUMOTLAR BAZASI
# ----------------------------------------------------------
# Mahalliy ishlab chiqish — SQLite (hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite+aiosqlite:///data/testlab.db
#
# Production — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://testlab:parol@localhost:5432/testlab

# SQL so'rovlarni konsolga chiqarish (faqat debug uchun)
DATABASE_ECHO=false

# ----------------------------------------------------------
#  5) REDIS  (IXTIYORIY)
# ----------------------------------------------------------
# Bo'sh qoldirilsa bot xotira rejimida ishlaydi.
# To'ldirilsa FSM holatlari va rate limiting Redis'da saqlanadi.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------
#  6) TEST TIZIMI
# ----------------------------------------------------------
# Bitta testdagi maksimal savollar soni
MAX_QUESTIONS=200

# Sertifikat va "o'tdi" belgisi uchun minimal foiz
DEFAULT_PASS_SCORE=60

# Bitta testga necha marta javob berish mumkin (0 = cheksiz)
DEFAULT_MAX_ATTEMPTS=1

# ----------------------------------------------------------
#  7) XAVFSIZLIK
# ----------------------------------------------------------
# Bir foydalanuvchi uchun ruxsat etilgan so'rovlar soni...
THROTTLE_RATE=20
# ...shuncha soniya oralig'ida
THROTTLE_PERIOD=10

# ----------------------------------------------------------
#  8) UMUMIY
# ----------------------------------------------------------
LOG_LEVEL=INFO

# UTC dan siljish (soatda). O'zbekiston = 5
TIMEZONE_OFFSET=5

PROJECT_NAME=TestLab

# ----------------------------------------------------------
#  9) GEMINI AI (IXTIYORIY - Mini App savollar tahlili uchun)
# ----------------------------------------------------------
# Google AI Studio'dan oling (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
